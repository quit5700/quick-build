{
  "schemaVersion": 1,
  "id": "quick_build",
  "version": "${version}",
  "name": "快捷建筑",
  "description": "整合建筑与移动魔杖、寻路信标、照明和无线红石工具。",
  "authors": ["quit5700"],
  "license": "All Rights Reserved",
  "environment": "*",
  "provides": ["building_wand", "pathfinding_beacon", "light"],
  "accessWidener": "light.accesswidener",
  "entrypoints": {
    "main": [
      "cn.quit5700.buildingwand.BuildingWandMod",
      "cn.quit5700.light.LightMod",
      "cn.quit5700.pathfindingbeacon.PathfindingBeaconMod"
    ],
    "client": [
      "cn.quit5700.pathfindingbeacon.PathfindingBeaconClient",
      "cn.quit5700.light.client.LightClient",
      "cn.quit5700.buildingwand.BuildingWandClient"
    ],
    "jade": ["cn.quit5700.light.compat.jade.LightJadePlugin"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": ">=${fabric_version}"
  },
  "suggests": {
    "jade": "*"
  }
}
